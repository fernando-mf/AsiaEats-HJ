{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "backend/",
      "framework": "nestjs",
      "entrypoint": "server.js",
      "buildCommand": "pnpm build",
      "installCommand": "pnpm install"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": { "service": "api" } }]
}
